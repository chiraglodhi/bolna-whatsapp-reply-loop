    {
      "parameters": {
        "jsCode": "const NL = String.fromCharCode(10);\nconst j = $json;\nlet prev = 'unknown node';\ntry { prev = $prevNode.name || prev; } catch (e) { prev = 'unknown node'; }\nlet ctx = {};\nlet v = {};\ntry { ctx = $('Normalize Payload').first().json; } catch (e) { ctx = {}; }\ntry { v = $('Validate Payload').first().json; } catch (e) { v = {}; }\nconst rawBody = v.raw_body || {};\nconst phone = ctx.customer_phone || v.customer_phone || rawBody.user_number || 'unknown';\nconst execId = ctx.execution_id || v.execution_id || rawBody.id || 'unknown';\nlet type = 'ERROR';\nlet desc = '';\nlet details = '';\nlet action = '';\nif (j.valid === false) {\n  desc = 'Invalid Bolna payload';\n  details = String(j.error || 'validation failed');\n  action = 'Open the n8n execution, compare the raw payload to the expected fields, and check PII masking';\n} else if (j.call_failure === true) {\n  type = 'CALL FAILURE';\n  desc = 'Bolna call ' + j.status + ' after ' + j.conversation_duration + 's of conversation';\n  details = 'Call: ' + execId + '. error_message: ' + (j.error_message || 'n/a');\n  action = 'Review the call in the Bolna dashboard';\n} else if (j.whatsapp_send_error) {\n  desc = 'WhatsApp follow-up failed to send';\n  details = 'Call: ' + execId + '. ' + String(j.whatsapp_send_error);\n  action = 'Check sandbox join status (3 days) and the 24h window (Twilio 21608/21610), then resend manually';\n} else {\n  const e = j.error;\n  let msg = 'unknown error, see the n8n execution';\n  if (typeof e === 'string') msg = e;\n  else if (e && e.message) msg = e.message;\n  else if (j.message) msg = j.message;\n  desc = 'Workflow node failed';\n  details = 'Node before this alert: ' + prev + '. Call: ' + execId + '. ' + String(msg).slice(0, 400);\n  action = 'Open the n8n execution and fix the failing node';\n}\nconst text = ['[' + type + '] — ' + desc, 'Phone: ' + phone, 'Workflow: WF1 Call Intake', 'Details: ' + details, 'Time: ' + new Date().toISOString(), 'Action needed: ' + action].join(NL);\nreturn [{ json: { slack_text: text, alert_type: type } }];"
      },
