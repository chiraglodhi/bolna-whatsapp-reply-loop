    {
      "parameters": {
        "jsCode": "const c = $('Normalize Payload').first().json;\nconst status = c.status;\nconst duration = c.conversation_duration;\nconst callFailure = (status === 'failed' || status === 'error') && duration > 0;\nlet message = '';\nif (status === 'completed' && duration > 0) {\n  message = \"Hi! Thank you for speaking with us. We wanted to follow up on our conversation. If you have any questions or would like to proceed, just reply to this message and we'll get back to you shortly.\";\n} else if (status === 'no-answer') {\n  message = \"Hi! We tried reaching you by phone but couldn't connect. We'd love to chat. Reply here if there's a better time to call, or let us know how we can help.\";\n} else if (status === 'busy') {\n  message = \"Hi! We tried calling but it seems you were busy. Reply here with a good time to call back.\";\n} else {\n  return [{ json: Object.assign({}, c, { skip_whatsapp: true, call_failure: callFailure, skip_reason: 'Status ' + status + ' (duration ' + duration + ') is not customer-facing' }) }];\n}\nreturn [{ json: Object.assign({}, c, { skip_whatsapp: false, call_failure: false, whatsapp_message: message }) }];"
      },
