    {
      "parameters": {
        "jsCode": "const v = $('Validate Payload').first().json;\nconst data = v.extracted_data || {};\nconst flat = {};\nObject.keys(data).forEach(function (category) {\n  const extractions = data[category];\n  if (extractions && typeof extractions === 'object') {\n    Object.keys(extractions).forEach(function (name) {\n      const x = extractions[name] || {};\n      let val = null;\n      if (x.objective !== undefined && x.objective !== null) val = x.objective;\n      else if (x.subjective !== undefined) val = x.subjective;\n      flat[category + '.' + name] = { value: val, confidence: x.confidence || 0, confidence_label: x.confidence_label || 'Low' };\n    });\n  }\n});\nconst row = {\n  execution_id: v.execution_id,\n  agent_id: v.agent_id,\n  batch_id: v.batch_id,\n  status: v.status,\n  smart_status: v.smart_status,\n  conversation_duration: v.conversation_duration,\n  answered_by_voice_mail: v.answered_by_voice_mail,\n  customer_phone: v.customer_phone,\n  agent_phone: v.agent_phone,\n  transcript: v.transcript,\n  summary: v.summary,\n  extracted_data: v.extracted_data,\n  telephony_provider: v.telephony_provider,\n  hangup_by: v.hangup_by,\n  hangup_reason: v.hangup_reason,\n  recording_url: v.recording_url,\n  total_cost_cents: v.total_cost_cents\n};\nreturn [{ json: Object.assign({}, v, { extracted_data_flat: flat, db_row: row }) }];"
      },
