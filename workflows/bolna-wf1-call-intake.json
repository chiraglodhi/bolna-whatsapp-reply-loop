    {
      "parameters": {
        "jsCode": "const body = $json.body || $json;\nconst required = ['id', 'status', 'user_number'];\nconst missing = required.filter(function (f) { return !body[f]; });\nif (missing.length > 0) {\n  return [{ json: { valid: false, error: 'Missing required fields: ' + missing.join(', '), raw_body: body } }];\n}\nlet phone = String(body.user_number || '').replace(/[^+0-9]/g, '');\nif (phone && !phone.startsWith('+')) phone = '+' + phone;\nconst td = body.telephony_data || {};\nreturn [{ json: {\n  valid: true,\n  execution_id: body.id,\n  agent_id: body.agent_id || '',\n  batch_id: body.batch_id || null,\n  status: body.status,\n  smart_status: body.smart_status || null,\n  error_message: body.error_message || null,\n  conversation_duration: Number(body.conversation_duration) || 0,\n  answered_by_voice_mail: body.answered_by_voice_mail === true,\n  customer_phone: phone,\n  agent_phone: body.agent_number || null,\n  transcript: body.transcript || '',\n  summary: body.summary || null,\n  extracted_data: body.extracted_data || {},\n  telephony_provider: body.provider || null,\n  hangup_by: td.hangup_by || null,\n  hangup_reason: td.hangup_reason || null,\n  recording_url: td.recording_url || null,\n  total_cost_cents: Math.round(Number(body.total_cost) || 0)\n} }];"
      },
